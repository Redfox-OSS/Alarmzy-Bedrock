<?xml version="1.0" encoding="utf-8"?>
<!--
  Add: a Bedrock line plus (1.75 stroke, round caps) drawn small inside its 24dp box, so it reads
  light and calm on the 56dp add buttons instead of a heavy filled glyph.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,7 L12,17 M7,12 L17,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.75"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
