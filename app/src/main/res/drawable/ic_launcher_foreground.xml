<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: an ember alarm clock with a softly filled face (Alarmzy Bedrock).
  Drawn on the design canvas, then scaled to 82% and nudged up so the bells stay inside the
  66dp adaptive-icon safe zone on every OEM mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.82"
        android:scaleY="0.82">
        <group android:translateY="-2">
            <!-- Face: colour inside the clock, never a glow around it (Bedrock) -->
            <path
                android:fillColor="#33F2884B"
                android:pathData="M32,58a22,22 0 1,0 44,0a22,22 0 1,0 -44,0" />
            <!-- Bells, aligned radially with the ring -->
            <group android:pivotX="54" android:pivotY="58" android:rotation="-42">
                <path
                    android:fillColor="#FFF2884B"
                    android:strokeColor="#FFF2884B"
                    android:strokeWidth="2"
                    android:strokeLineJoin="round"
                    android:pathData="M47,30.5A7,7 0 0,1 61,30.5Z" />
            </group>
            <group android:pivotX="54" android:pivotY="58" android:rotation="42">
                <path
                    android:fillColor="#FFF2884B"
                    android:strokeColor="#FFF2884B"
                    android:strokeWidth="2"
                    android:strokeLineJoin="round"
                    android:pathData="M47,30.5A7,7 0 0,1 61,30.5Z" />
            </group>
            <!-- Ring -->
            <path
                android:strokeColor="#FFF2884B"
                android:strokeWidth="5"
                android:pathData="M32,58a22,22 0 1,0 44,0a22,22 0 1,0 -44,0" />
            <!-- Hands + pivot -->
            <path
                android:strokeColor="#FFF3F2EF"
                android:strokeWidth="4"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M54,46V58L61.5,63" />
            <path
                android:fillColor="#FFF3F2EF"
                android:pathData="M51.4,58a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0" />
        </group>
    </group>
</vector>
