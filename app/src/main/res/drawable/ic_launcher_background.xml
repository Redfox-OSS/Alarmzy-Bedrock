        android:fillColor="#FF7A3212"
        android:pathData="M0,0h108v108h-108z" />
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="20"
                android:gradientRadius="96">
                <item android:offset="0" android:color="#FFF2884B" />
                <item android:offset="0.5" android:color="#80F2884B" />
