                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="78">
                <item android:offset="0" android:color="#FFE8607A" />
                <item android:offset="0.5" android:color="#80E8607A" />
                <item android:offset="1" android:color="#00E8607A" />
            </gradient>
