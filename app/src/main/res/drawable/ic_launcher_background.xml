<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher background: a soft red-to-pink aura in Bedrock style. Red light falls from the top
  left, pink from the bottom right, over a rose-red base, so the sweep never dips dark in the middle. Colour inside the surface, no glow.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFB8475A"
        android:pathData="M0,0h108v108h-108z" />
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="20"
                android:gradientRadius="96">
                <item android:offset="0" android:color="#FFE5484D" />
                <item android:offset="0.5" android:color="#BFE5484D" />
                <item android:offset="1" android:color="#00E5484D" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="78">
                <item android:offset="0" android:color="#FFEC6F8E" />
                <item android:offset="0.5" android:color="#BFEC6F8E" />
                <item android:offset="1" android:color="#00EC6F8E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
